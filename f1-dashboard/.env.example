# Local quickstart. Change PUBLIC_BASE_URL to your HTTPS origin for public RSS.
PUBLIC_BASE_URL=http://127.0.0.1:5173
# If the existing npm preview uses 5173, use 5174 and update PUBLIC_BASE_URL too.
HOST_PORT=5173
# For compose.proxy.yaml only: the EXISTING external network used by your proxy.
PROXY_NETWORK=
